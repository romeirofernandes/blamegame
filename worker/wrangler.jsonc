{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blame-game",
  "main": "src/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "FIREBASE_PROJECT_ID": "blame-game-edf11" },
  "observability": { "enabled": true },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/ws", "/ws/*", "/api/community", "/api/community/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "COMMUNITY_CATALOG", "class_name": "CommunityCatalog" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["CommunityCatalog"] }
  ]
}
