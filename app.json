{
  "expo": {
    "name": "Blame Game",
    "slug": "blame-game",
    "scheme": "blamegame",
    "version": "1.0.0",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15131d",
    "icon": "./assets/app-icon.png",
    "ios": {
      "bundleIdentifier": "com.blamegame.app",
      "supportsTablet": true,
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": {
      "package": "com.blamegame.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15131d"
      }
    },
    "web": {
      "output": "single",
      "themeColor": "#100e16",
      "description": "A live party game for the group chat.",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": ["expo-font"]
  }
}
