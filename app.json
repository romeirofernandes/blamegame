{
  "expo": {
    "name": "Blame Game",
    "slug": "blame-game",
    "scheme": "blamegame",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#15131d",
    "icon": "./assets/app-icon.png",
    "ios": {
      "bundleIdentifier": "com.blamegame.app",
      "supportsTablet": true,
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": {
      "package": "com.blame.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15131d"
      }
    },
    "web": {
      "output": "single",
      "description": "A live party game for the group chat.",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-font",
      ["expo-image-picker", {
        "photosPermission": "Choose a profile photo to share with players in your Blame Game room.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ]
  }
}
