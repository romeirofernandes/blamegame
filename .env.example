# Optional public Firebase settings. Expo can read these from google-services.json.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional Google web OAuth client ID override; otherwise read from google-services.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional iOS client ID and reversed URL scheme; normally read from GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Set this to your deployed Worker origin when building a standalone app.
EXPO_PUBLIC_SERVER_URL=
